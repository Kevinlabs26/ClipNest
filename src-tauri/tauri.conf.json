{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipNest",
  "version": "0.1.7",
  "identifier": "app.clipnest.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "ClipNest",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Offline bilingual content library"
  }
}
